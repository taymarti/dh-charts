{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "lightweight-charts": [
        "./node_modules/lightweight-charts"
      ],
      "@acme/chart-ext": [
        "../../ext/src/index.ts"
      ],
      "@acme/chart-react": [
        "../../react/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ]
}
