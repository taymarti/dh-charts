{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@acme/chart-ext": ["../ext/src/index.ts"],
      "@acme/chart-react": ["../react/src/index.ts"],
      "@acme/dh-bindings": ["../bindings/src/index.ts"],
      "lightweight-charts": ["./node_modules/lightweight-charts"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "@deephaven/jsapi-types": ["./node_modules/@deephaven/jsapi-types"]
    }
  },
  "include": ["src"]
}
