# dependencies and build output
# node_modules is ignored except the Lightweight Charts packages, which are committed resolved (and
# vendored as tarballs in vendor/) for environments whose package mirror lacks them
**/node_modules/*
!**/node_modules/lightweight-charts/
!**/node_modules/fancy-canvas/
!**/node_modules/@tradingview/
dist/
!**/node_modules/lightweight-charts/dist/
!**/node_modules/@tradingview/*/dist/
dh-plugin/src/dh_chart_ext/_js/dist/
__pycache__/
*.egg-info/
.venv/

# Deephaven server runtime state (run_server.py writes these in the working directory)
layouts/
notebooks/

# local tool settings
.claude/settings.local.json

# demo app data
app.d/annotations.parquet
